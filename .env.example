# GloxPaw AI Configuration
# Copy this file to .env and fill in your values

# OpenRouter API Key
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model
# Popular options:
#   - openai/gpt-4-vision (Best quality, supports vision)
#   - openai/gpt-4o (Latest GPT-4, vision capable)
#   - openai/gpt-4-turbo (Good balance, vision capable)
#   - anthropic/claude-3-opus (Excellent quality)
#   - anthropic/claude-3-sonnet (Good quality, faster)
#   - meta-llama/llama-2-70b-chat (Open source, vision limited)
#
# For best results with animal analysis, use a model with vision capabilities (gpt-4-vision or gpt-4o recommended)
OPENROUTER_MODEL=openai/gpt-4-vision
